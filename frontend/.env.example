# Configuracao do frontend (dashboard). Copie para .env.local e ajuste conforme o ambiente.
# NAO inclua segredos: variaveis NEXT_PUBLIC_* sao expostas ao navegador.

# URL base da API FastAPI (o prefixo /api e adicionado pela camada de servicos).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Modo mock (fallback de desenvolvimento SEM backend). O padrao e a API real.
# Defina como "true" apenas para desenvolver a UI sem o backend disponivel.
NEXT_PUBLIC_USAR_MOCK=false
