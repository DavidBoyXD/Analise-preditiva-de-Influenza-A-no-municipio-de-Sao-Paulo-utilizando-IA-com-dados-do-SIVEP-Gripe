# =============================================================================
# .env.example - Exemplo de variaveis de ambiente da API (RF001/RF003).
#
# Copie este arquivo para .env e ajuste os valores. NUNCA versione o .env com
# credenciais reais (o .env ja esta no .gitignore). Nenhuma credencial fica
# embutida no codigo: a API le DATABASE_URL desta variavel de ambiente.
# =============================================================================

# String de conexao SQLAlchemy do banco.
#
# PostgreSQL (producao) - substitua usuario, senha, host, porta e nome do banco:
# DATABASE_URL=postgresql+psycopg2://USUARIO:SENHA@HOST:5432/influenza_sp
#
# SQLite (desenvolvimento/testes locais) - sem credenciais:
DATABASE_URL=sqlite:///./influenza_dev.db

# Nome e versao exibidos na documentacao OpenAPI/Swagger.
APP_NOME=API de Analise Preditiva de Influenza A - Municipio de Sao Paulo
APP_VERSAO=0.1.0

# Horizonte padrao de previsao (em semanas).
HORIZONTE_PREVISAO_SEMANAS=6

# Diretorio onde os arquivos .joblib do modelo sao procurados na inicializacao.
CAMINHO_MODELOS=../models

# Codigo IBGE do municipio de referencia (Sao Paulo capital).
CO_MUN_RES_PADRAO=355030

# Origens permitidas para CORS (separadas por virgula). "*" libera todas.
CORS_ORIGENS=["*"]
